# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://mdscrm:sua_senha_forte@postgres:5432/mds_crm"

# ============================================
# NEXTAUTH - Authentication
# ============================================
# Gerar secret: openssl rand -base64 32
NEXTAUTH_SECRET="cole_aqui_o_secret_gerado_com_openssl"
NEXTAUTH_URL="https://crm.mundodigitalsolucoes.com.br"
# URL pública usada para callbacks/webhooks externos
NEXT_PUBLIC_APP_URL="https://crm.mundodigitalsolucoes.com.br"

# ============================================
# CHATWOOT INTEGRATION
# ============================================
# Base pública do Chatwoot; o CRM normaliza/removerá /api/v1 se informado.
CHATWOOT_API_URL="https://app.mundodigitalsolucoes.com.br"
CHATWOOT_API_KEY="sua-chatwoot-api-key-aqui"
CHATWOOT_ACCOUNT_ID="1"
CHATWOOT_PLATFORM_TOKEN="seu-platform-token"
CHATWOOT_WEBHOOK_SECRET="cole_aqui_o_secret_do_webhook"

# ============================================
# GOOGLE GEMINI AI
# ============================================
GEMINI_API_KEY="sua-gemini-api-key"

# ============================================
# STRIPE (ou Pagar.me)
# ============================================
# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Ou Pagar.me (comentar Stripe se usar Pagar.me)
# PAGARME_API_KEY="sua-api-key-pagarme"
# PAGARME_ENCRYPTION_KEY="sua-encryption-key"

# ============================================
# EMAIL (Opcional - para notificações)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@mundodigitalsolucoes.com.br"
SMTP_PASSWORD="sua-senha-de-app"
SMTP_FROM="noreply@mundodigitalsolucoes.com.br"

# ============================================
# UPLOADS (Opcional - S3/CloudFlare R2)
# ============================================
# AWS_ACCESS_KEY_ID="sua-access-key"
# AWS_SECRET_ACCESS_KEY="sua-secret-key"
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME="mds-crm-uploads"

# ============================================
# ANALYTICS (Opcional)
# ============================================
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_HOTJAR_ID="XXXXXXX"

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV="production"
